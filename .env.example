# Copy this file to .env and fill in your DVR credentials.
# .env is git-ignored and is read only by the local backend.

# --- DVR connection ---
DVR_HOST=192.168.1.100
DVR_HTTP_PORT=80
DVR_RTSP_PORT=554
DVR_USER=admin
DVR_PASS=changeme

# Number of channels to expose (the XVR reports 5 video sources)
DVR_CHANNELS=5

# --- Local services ---
# Backend API port (the web app proxies /api to this; the built site is served here too)
SERVER_PORT=8787

# go2rtc binary: leave unset to use the bundled go2rtc-static npm package;
# uncomment and set an absolute path to use your own build instead.
# GO2RTC_BIN=/usr/local/bin/go2rtc
# go2rtc API port (bound to 127.0.0.1, not exposed to the LAN)
GO2RTC_API_PORT=1984
# go2rtc WebRTC media port (browser connects here directly for media)
GO2RTC_WEBRTC_PORT=8555
